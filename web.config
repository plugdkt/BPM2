<?xml version="1.0" encoding="UTF-8"?>
<!--
  Root-level web.config — จำเป็นเฉพาะเมื่อ IIS site physical path ชี้มาที่ root ของ repo นี้
  (ไม่ใช่แค่ public/ ตามที่ spec.md ออกแบบไว้แต่แรก — ดู spec.md ข้อ 10/11)

  บล็อกไม่ให้เข้าถึงโฟลเดอร์/ไฟล์ที่ไม่ควรเปิดเผยผ่าน URL โดยตรง เช่น
  config/config.php (DB password + SSO client secret), sql/schema.sql (DB schema เต็ม),
  src/ (โค้ด business logic รวม path จริงของ server), vendor/, docker/, ψ/ (Oracle memory),
  composer.json/.lock, .git/ (ถ้า deploy ทั้งโฟลเดอร์รวม .git มาด้วย)

  hiddenSegments บล็อกทุก URL ที่มี segment นี้อยู่ ไม่ว่าจะอยู่ระดับไหนของ path
-->
<configuration>
    <system.webServer>
        <httpErrors existingResponse="PassThrough" />
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="config" />
                    <add segment="src" />
                    <add segment="sql" />
                    <add segment="vendor" />
                    <add segment="docker" />
                    <add segment="scripts" />
                    <add segment=".git" />
                    <add segment="ψ" />
                    <add segment="composer.json" />
                    <add segment="composer.lock" />
                    <add segment="composer.phar" />
                    <add segment="spec.md" />
                    <add segment="CLAUDE.md" />
                    <add segment="BPM_UI_UX_GUIDELINES.md" />
                    <add segment="sso_integration_guide.md" />
                    <add segment="BPM_70.xlsx" />
                    <add segment="BPM_report69.xlsx" />
                </hiddenSegments>
                <fileExtensions>
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".md" allowed="false" />
                    <add fileExtension=".lock" allowed="false" />
                    <add fileExtension=".json" allowed="false" />
                    <add fileExtension=".yml" allowed="false" />
                    <add fileExtension=".yaml" allowed="false" />
                    <add fileExtension=".phar" allowed="false" />
                    <add fileExtension=".xlsx" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
