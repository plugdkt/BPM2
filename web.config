<?xml version="1.0" encoding="utf-8"?>
<!--
  ใช้กับ iisnode เท่านั้น ต้องอยู่ในโฟลเดอร์เดียวกับ server.js
  (คือ .next/standalone/ หลัง build — ดูขั้นตอนใน DEPLOY.md)

  Prerequisite บนเครื่อง IIS server:
    - Node.js LTS ติดตั้งแล้ว (node ต้องอยู่ใน PATH)
    - IIS module: URL Rewrite (https://www.iis.net/downloads/microsoft/url-rewrite)
    - IIS module: iisnode (https://github.com/Azure/iisnode/releases)
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- ส่งทุก request เข้า server.js (Next.js standalone server จัดการ
         ทั้งหน้าเว็บ, API route, และไฟล์ static เอง — ดู self-hosting.md
         ใน node_modules/next/dist/docs) -->
    <rewrite>
      <rules>
        <rule name="BPM-all-to-node">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode
      node_env="production"
      nodeProcessCountPerApplication="1"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      flushResponse="true"
      watchedFiles="web.config"
    />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment=".next" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
