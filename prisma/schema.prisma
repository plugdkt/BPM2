generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEPT_STAFF
  EXECUTIVE_VIEWER
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime @default(now())

  transactionsCreated Transaction[]     @relation("TransactionCreatedBy")
  transfersRequested  BudgetTransfer[]  @relation("TransferRequestedBy")
  transfersApproved   BudgetTransfer[]  @relation("TransferApprovedBy")
}

model Department {
  id   String @id @default(cuid())
  name String
  code String @unique

  users       User[]
  allocations BudgetAllocation[]
  transfers   BudgetTransfer[]
}

model FiscalYear {
  id        String   @id @default(cuid())
  yearBE    Int      @unique // พ.ศ. เช่น 2569
  startDate DateTime // 1 ต.ค. ปี (yearBE-1)
  endDate   DateTime // 30 ก.ย. ปี yearBE

  allocations BudgetAllocation[]
  transfers   BudgetTransfer[]
}

model BudgetCategory {
  id   String @id @default(cuid())
  name String
  code String @unique

  allocations        BudgetAllocation[]
  transfersFrom      BudgetTransfer[]   @relation("TransferFromCategory")
  transfersTo        BudgetTransfer[]   @relation("TransferToCategory")
}

model BudgetAllocation {
  id           String   @id @default(cuid())
  departmentId String
  categoryId   String
  fiscalYearId String
  amount       Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())

  department Department     @relation(fields: [departmentId], references: [id])
  category   BudgetCategory @relation(fields: [categoryId], references: [id])
  fiscalYear FiscalYear     @relation(fields: [fiscalYearId], references: [id])

  transactions Transaction[]

  @@unique([departmentId, categoryId, fiscalYearId])
}

model Transaction {
  id           String          @id @default(cuid())
  allocationId String
  type         TransactionType
  amount       Decimal         @db.Decimal(14, 2)
  description  String
  referenceNo  String?
  date         DateTime
  createdById  String
  createdAt    DateTime        @default(now())

  allocation BudgetAllocation @relation(fields: [allocationId], references: [id])
  createdBy  User             @relation("TransactionCreatedBy", fields: [createdById], references: [id])
}

model BudgetTransfer {
  id             String         @id @default(cuid())
  fiscalYearId   String
  departmentId   String
  fromCategoryId String
  toCategoryId   String
  amount         Decimal        @db.Decimal(14, 2)
  reason         String
  status         TransferStatus @default(PENDING)
  requestedById  String
  approvedById   String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())

  fiscalYear   FiscalYear     @relation(fields: [fiscalYearId], references: [id])
  department   Department     @relation(fields: [departmentId], references: [id])
  fromCategory BudgetCategory @relation("TransferFromCategory", fields: [fromCategoryId], references: [id])
  toCategory   BudgetCategory @relation("TransferToCategory", fields: [toCategoryId], references: [id])
  requestedBy  User           @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy   User?          @relation("TransferApprovedBy", fields: [approvedById], references: [id])
}
