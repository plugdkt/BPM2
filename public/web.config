<?xml version="1.0" encoding="UTF-8"?>
<!--
  ดู spec.md ข้อ 11 สำหรับขั้นตอน deploy เต็ม
  Physical path ของ IIS Site ต้องชี้มาที่โฟลเดอร์ public/ นี้เท่านั้น (ไม่ใช่ root ของ repo)

  FastCGI handler mapping สำหรับ PHP ตั้งค่าผ่าน PHP Manager for IIS ที่ระดับ Site/Server แล้ว
  (เครื่อง production มี PHP 8.2 ติดตั้งพร้อมสิทธิ์ admin อยู่แล้ว — ยืนยันจากลูกค้า) จึงไม่ต้องประกาศ
  <handlers> ซ้ำในไฟล์นี้ — ถ้า PHP Manager ยังไม่เคย map ให้ไซต์นี้ ให้ทำผ่าน IIS Manager ก่อน ไม่ใช่แก้ไฟล์นี้
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <!-- กัน error ของ PHP หลุดออกมาเป็นหน้า IIS แบบดิบ ให้ error.php/global handler ของ BPM จัดการแทน -->
    <httpErrors errorMode="Detailed" existenceCache="false" />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="web.config" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
